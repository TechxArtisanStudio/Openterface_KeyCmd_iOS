{
  "version": "1.0.0",
  "defaults": {
    "providerName": "OpenAI",
    "role": "text_refinement",
    "sttEngine": "apple"
  },
  "providerPresets": [
    {
      "name": "OpenAI",
      "apiBaseURL": "https://api.openai.com/v1",
      "modelName": "gpt-4o",
      "apiKeyOptional": false
    },
    {
      "name": "Ollama (Local)",
      "apiBaseURL": "http://localhost:11434/v1",
      "modelName": "llama3",
      "apiKeyOptional": true
    },
    {
      "name": "DeepSeek",
      "apiBaseURL": "https://api.deepseek.com/v1",
      "modelName": "deepseek-chat",
      "apiKeyOptional": false
    },
    {
      "name": "Qwen (Alibaba)",
      "apiBaseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "modelName": "qwen-plus",
      "apiKeyOptional": false
    },
    {
      "name": "GLM (Zhipu AI)",
      "apiBaseURL": "https://open.bigmodel.cn/api/paas/v4",
      "modelName": "glm-4-flash",
      "apiKeyOptional": false
    },
    {
      "name": "Local Qwen 0.6B",
      "apiBaseURL": "local://qwen3-0.6b",
      "modelName": "Qwen3-0.6B-4bit",
      "apiKeyOptional": true
    },
    {
      "name": "Local Qwen 1.7B",
      "apiBaseURL": "local://qwen3-1.7b",
      "modelName": "Qwen3-1.7B-4bit",
      "apiKeyOptional": true
    }
  ],
  "roles": [
    {
      "id": "text_refinement",
      "name": "Text Refinement",
      "description": "Refine voice transcription for clarity",
      "promptFile": "Prompts/text_refinement.md"
    },
    {
      "id": "command_assistant",
      "name": "Command Assistant",
      "description": "Convert voice commands to keyboard/mouse actions. Prompt adapts automatically to the configured target OS.",
      "promptFile": "Prompts/command_assistant.md"
    },
    {
      "id": "agent_planner",
      "name": "Agent Planner",
      "description": "Generate execution plans for the Agent to run on the connected device",
      "promptFile": "Prompts/agent_planner.md"
    },
    {
      "id": "agent_planner_terminal",
      "name": "Agent Planner (Terminal)",
      "description": "Planner prompt when SSH terminal is active — focused on shell commands",
      "promptFile": "Prompts/agent_planner_terminal.md"
    },
    {
      "id": "agent_planner_hid",
      "name": "Agent Planner (HID)",
      "description": "Planner prompt when no SSH — focused on BLE keyboard input",
      "promptFile": "Prompts/agent_planner_hid.md"
    },
    {
      "id": "custom",
      "name": "Custom",
      "description": "Use your own system prompt",
      "prompt": ""
    }
  ]
}
